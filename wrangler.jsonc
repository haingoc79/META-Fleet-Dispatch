{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meta-fleet-dispatch",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meta-fleet-dispatch-prod",
      "database_id": "0467fc36-a689-40bf-92db-21db69c0f26c"
    }
  ],
  "routes": [
    {
      "pattern": "giaohang.meta.shopping",
      "custom_domain": true
    }
  ],
  "vars": {
    "MFD_ALLOW_UNAUTHENTICATED": "false"
  }
}
